PROJECT_NAME="Abbay"
BUILD_PATH="$PWD/Build"

xcodebuild clean test \
    -project $PROJECT_NAME.xcodeproj \
    -scheme $PROJECT_NAME \
    -sdk iphonesimulator \
    -destination 'platform=iOS Simulator,OS=17.0,name=iPhone 15'

xcodebuild clean archive \
    -project $PROJECT_NAME.xcodeproj \
    -scheme $PROJECT_NAME \
    -sdk iphoneos \
    -configuration release \
    -archivePath $BUILD_PATH/$PROJECT_NAME.xcarchive

xcodebuild -exportArchive \
    -archivePath $BUILD_PATH/$PROJECT_NAME.xcarchive \
    -exportPath $BUILD_PATH/$PROJECT_NAME.ipa \
    -exportOptionsPlist $BUILD_PATH/$PROJECT_NAME.xcarchive/Info.plist
