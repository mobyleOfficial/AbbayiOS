    "audioStatusUnavailableDetail" : {
      "comment" : "Explains the unavailable status",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio could not start the last time Abbay opened, so Siri answers “Audio temporarily unavailable”. This clears by itself the next time a book plays."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio não pôde ser iniciado na última vez que o Abbay abriu, por isso a Siri responde “Áudio temporariamente indisponível”. Isso se resolve sozinho na próxima vez que um livro tocar."
          }
        }
      }
