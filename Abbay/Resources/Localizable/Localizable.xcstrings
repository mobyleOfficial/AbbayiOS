    "licensesBody" : {
      "comment" : "Open-source licenses page body",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbay includes no third-party libraries. All of its code, including the NetworkProvider networking module, is written by Mobyle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Abbay não inclui bibliotecas de terceiros. Todo o código, incluindo o módulo de rede NetworkProvider, é escrito pela Mobyle."
