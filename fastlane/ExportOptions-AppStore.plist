<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store Connect / TestFlight distribution. Used by the `release` lane. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>2X5PWXY74F</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Export the .ipa locally; fastlane's upload_to_testflight does the upload. -->
	<key>destination</key>
	<string>export</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- The `version` file is the source of truth for version and build number. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
